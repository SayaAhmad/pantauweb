# Rahasia untuk Wasmer Edge.
#
# Salin ke .env.wasmer (tidak di-commit), isi nilainya, lalu:
#   php scripts/check-wasmer-env.php .env.wasmer
#   wasmer app secret import --from-file=.env.wasmer
#
# PENTING: JANGAN memakai file .env lokal di sini.
# .env berisi DB_HOST/DB_USERNAME Supabase, APP_ENV=local, APP_DEBUG=true,
# QUEUE_CONNECTION=database, dan APP_URL=http://localhost. Semua itu menimpa
# konfigurasi Wasmer dan membuat deploy/migrasi gagal.
#
# File ini HANYA berisi nilai yang tidak diatur app.yaml.
# DB_*, APP_ENV, APP_DEBUG, APP_URL, SESSION_DRIVER, CACHE_STORE,
# QUEUE_CONNECTION, LOG_CHANNEL, dan FILESYSTEM_DISK sudah diatur di app.yaml
# atau disuntikkan Wasmer. Jangan tambahkan ke sini.

# Wajib. Buat dengan: php artisan key:generate --show
APP_KEY=

# Wajib. Dipakai job pantau-deploy untuk membuat akun admin pertama.
ADMIN_EMAIL=admin@pantau.test
ADMIN_PASSWORD=ganti-dengan-kata-sandi-kuat

# Opsional: penerima email insiden. Isi juga kredensial MAIL_* di bawah.
# Untuk memakai sendmail bawaan Edge, tambahkan enable_email: true di app.yaml
# lalu set MAIL_MAILER=sendmail.
# MONITOR_ALERT_EMAIL=ops@example.com
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_SCHEME=tls
# MAIL_FROM_ADDRESS=ops@example.com
